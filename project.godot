;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cooking Sim"
run/main_scene="uid://cf5g4lgl0kvft"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RecipeManager="*uid://duokqw7ab46iv"

[dotnet]

project/assembly_name="Cooking Sim"

[editor_plugins]

enabled=PackedStringArray("res://addons/GlbImportPipeline/plugin.cfg")

[file_customization]

folder_colors={
"res://Features/": "green",
"res://Objects/": "red",
"res://PlayerCharacter/": "orange",
"res://Recipe/": "blue"
}

[filesystem]

